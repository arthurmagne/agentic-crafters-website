---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import EpisodesIndex from '../../../components/EpisodesIndex.astro';
import Footer from '../../../components/Footer.astro';
import { episodesPath, type Locale } from '../../../i18n/ui';
import { ui } from '../../../i18n/ui';

const lang = 'fr' as const;
const paths: Record<Locale, string> = {
  en: episodesPath('en'),
  fr: episodesPath('fr'),
};
---

<Base lang={lang} title={ui[lang].episodesMetaTitle} description={ui[lang].episodesMetaDescription} paths={paths}>
  <a class="skip" href="#contenu">{ui[lang].skip}</a>
  <Header lang={lang} currentPage="episodes" />
  <EpisodesIndex lang={lang} />
  <Footer lang={lang} />
</Base>
