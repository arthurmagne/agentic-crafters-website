---
import { ui, paths, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="wrap footer">
  <a class="footer-brand" href={paths[lang]}>Agentic Crafters.</a>
  <span>{t.footerTagline}</span>
  <a href="#contenu">{t.footerTop} ↑</a>
</footer>
