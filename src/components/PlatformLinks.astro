---
import PlatformIcon from './PlatformIcon.astro';
import { platformNames, type Platform } from '../data/platforms';

interface Props {
  label: string;
  links: { platform: Platform; href: string }[];
  class?: string;
}

const { label, links, class: className } = Astro.props;
---

<nav class:list={['platform-links', className]} aria-label={label}>
  <span class="platform-links-label">{label}</span>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <PlatformIcon platform={link.platform} />
            {platformNames[link.platform]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
