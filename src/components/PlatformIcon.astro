---
import type { Platform } from '../data/platforms';

interface Props {
  platform: Platform;
}

const { platform } = Astro.props;
---

<svg class="platform-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
  {
    platform === 'youtube' && (
      <>
        <rect x="1.5" y="4.5" width="21" height="15" rx="4.5" fill="currentColor" />
        <path d="M10 8.8v6.4l5.6-3.2z" fill="var(--icon-cut, #fff)" />
      </>
    )
  }
  {
    platform === 'spotify' && (
      <>
        <circle cx="12" cy="12" r="10.5" fill="currentColor" />
        <g fill="none" stroke="var(--icon-cut, #fff)" stroke-linecap="round">
          <path d="M6.6 9.2c3.7-1.1 7.7-.8 10.9 1" stroke-width="1.9" />
          <path d="M7.2 12.4c3-.8 6.1-.5 8.7.9" stroke-width="1.6" />
          <path d="M7.8 15.4c2.3-.6 4.6-.4 6.6.7" stroke-width="1.3" />
        </g>
      </>
    )
  }
  {
    platform === 'apple' && (
      <>
        <rect x="1.5" y="1.5" width="21" height="21" rx="6" fill="currentColor" />
        <g fill="none" stroke="var(--icon-cut, #fff)" stroke-width="1.5" stroke-linecap="round">
          <path d="M7.6 15.2a5.6 5.6 0 1 1 8.8 0" />
          <path d="M9.6 13.4a3 3 0 1 1 4.8 0" />
        </g>
        <circle cx="12" cy="11.2" r="1.4" fill="var(--icon-cut, #fff)" />
        <path d="M11.1 14.2h1.8l-.35 4.6h-1.1z" fill="var(--icon-cut, #fff)" />
      </>
    )
  }
</svg>
