---
import { ui, episodesPath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
// La couverture de la vidéo vit dans un srcdoc transparent : un simple lien
// plein cadre, posé sur la couverture dessinée par la page. Au clic, l'iframe
// navigue vers le lecteur YouTube en lecture auto. Rien n'est chargé chez
// YouTube avant le clic, et la page ne gagne aucun script.
const videoCoverDoc = `<style>html,body{margin:0;height:100%}a{position:fixed;inset:0;cursor:pointer}a:focus-visible{outline-offset:-6px}span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}</style><a href="https://www.youtube-nocookie.com/embed/-1VyWctfkXU?autoplay=1"><span>${t.videoCoverCta}</span></a>`;
const signalBars = Array.from({ length: 17 });
---

<main id="contenu">
  <section class="hero wrap" aria-labelledby="titre">
    <div class="eyebrow">{t.heroEyebrow}</div>
    <h1 id="titre">agentic<span class="second">crafters</span></h1>
    <div class="hero-bottom">
      <h2>{t.taglineLines[0]}<br />{t.taglineLines[1]}<br /><span>{t.taglineMark}</span></h2>
      <div class="hero-copy">
        <p>{t.heroQuestion}</p><a class="button" href={episodesPath(lang)}
          >{t.heroCta} <span aria-hidden="true">↘</span></a
        >
      </div>
    </div>
    <div class="hero-meta"><span>{t.heroMetaHosts}</span><span>{t.heroMetaClaim}</span></div>
  </section>

  <section class="intro-video wrap" id="episode-zero" aria-label={t.videoLabel}>
    <div class="video-frame">
      <div class="video-cover" aria-hidden="true">
        <span class="eyebrow">{t.videoCoverEyebrow}</span>
        <span class="video-cover-title"
          >{t.videoCoverTitleLines[0]}<br />{t.videoCoverTitleLines[1]}</span
        >
        <span class="button">{t.videoCoverCta} <span>▶</span></span>
      </div>
      <iframe
        srcdoc={videoCoverDoc}
        title={t.videoTitle}
        referrerpolicy="strict-origin-when-cross-origin"
        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
    <p class="video-caption">{t.videoCaption}</p>
  </section>

  <section class="approach" id="approche" aria-labelledby="approche-titre">
    <div class="wrap approach-grid">
      <div>
        <p class="eyebrow light">{t.approachEyebrow}</p>
        <div class="signal" aria-hidden="true">{signalBars.map(() => <span />)}</div>
        <p class="signal-caption">{t.signalCaption}</p>
      </div>
      <div>
        <h2 id="approche-titre"
          >{t.approachTitleLine1}<br />{t.approachTitleLine2}<em>{t.approachTitleEm}</em></h2
        >
        <p>{t.approachP1}</p>
        <p>{t.approachP2}</p>
        <div class="takeaway">{t.approachTakeaway}</div>
      </div>
    </div>
  </section>

  <section class="topics wrap" id="sujets" aria-labelledby="sujets-titre">
    <div class="section-heading">
      <p class="eyebrow">{t.topicsEyebrow}</p>
      <h2 id="sujets-titre">{t.topicsTitleLines[0]}<br />{t.topicsTitleLines[1]}</h2>
    </div>
    <div class="topic-list">
      {
        t.topics.map((topic, index) => (
          <article>
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <h3>
              {topic.titleLines[0]}
              <br />
              {topic.titleLines[1]}
            </h3>
            <p>{topic.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="hosts wrap" id="hotes" aria-labelledby="hotes-titre">
    <div class="section-heading">
      <p class="eyebrow">{t.hostsEyebrow}</p>
      <h2 id="hotes-titre">{t.hostsTitleLines[0]}<br />{t.hostsTitleLines[1]}</h2>
    </div>
    <div class="host-grid">
      <article class="host">
        <span class="initials" aria-hidden="true">AM</span>
        <div><h3>Arthur Magne</h3><p>{t.arthurRole}</p><p class="bio">{t.arthurBio}</p></div>
      </article>
      <article class="host">
        <span class="initials" aria-hidden="true">YG</span>
        <div>
          <h3>Yannick Grenzinger</h3><p>{t.yannickRole}</p><p class="bio">{t.yannickBio}</p><a
            href="https://www.linkedin.com/in/yannickgrenzinger/"
            >{t.yannickLinkedIn}</a
          >
        </div>
      </article>
    </div>
    <p class="audience">{t.audience}</p>
  </section>

  <section class="closing" aria-labelledby="closing-titre">
    <div class="wrap closing-inner">
      <div>
        <p class="eyebrow">{t.closingEyebrow}</p>
        <h2 id="closing-titre">{t.closingTitleLines[0]}<br />{t.closingTitleLines[1]}</h2>
      </div>
      <div class="closing-copy">
        <p>{t.closingBody}</p>
        <a class="button" href="#episode-zero"
          >{t.closingCta} <span aria-hidden="true">↘</span></a
        >
      </div>
    </div>
  </section>
</main>
