---
import { ui, locales, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<header class="header wrap">
  <a class="wordmark" href={localePath(lang)} aria-label={t.homeLabel}>ac</a>
  <nav aria-label={t.navLabel}
    ><a href="#approche">{t.navPodcast}</a><a href="#sujets">{t.navTopics}</a><a href="#hotes"
      >{t.navHosts}</a
    ></nav
  >
  <div class="header-end">
    <p class="lang" aria-label={t.langLabel}>
      {
        /* Ordre fixe : la langue courante est signalée par aria-current, jamais
           en changeant de place, pour que la cible reste au même endroit. */
        locales.map((code, index) => (
          <>
            {index > 0 && <em aria-hidden="true">/</em>}
            <a
              href={localePath(code)}
              lang={ui[code].htmlLang}
              hreflang={ui[code].htmlLang}
              aria-current={code === lang ? 'true' : undefined}
            >
              {code.toUpperCase()}
            </a>
          </>
        ))
      }
    </p>
  </div>
</header>
