---
import { ui, locales, localePath, episodesPath, episodePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  currentPage?: 'home' | 'episodes' | 'episode';
  episodeSlug?: string;
}

const { lang, currentPage = 'home', episodeSlug } = Astro.props;
const t = ui[lang];
const sectionHref = (section: string) =>
  currentPage === 'home' ? `#${section}` : `${localePath(lang)}#${section}`;
const pageHref = (locale: Locale) => {
  if (currentPage === 'episodes') return episodesPath(locale);
  if (currentPage === 'episode' && episodeSlug) return episodePath(locale, episodeSlug);
  return localePath(locale);
};
---

<header class="header wrap">
  <a class="wordmark" href={localePath(lang)} aria-label={t.homeLabel}>Agentic Crafter</a>
  <nav aria-label={t.navLabel}>
    <a href={sectionHref('approche')}>{t.navPodcast}</a>
    <a href={sectionHref('sujets')}>{t.navTopics}</a>
    <a href={sectionHref('hotes')}>{t.navHosts}</a>
    <a href={episodesPath(lang)} aria-current={currentPage === 'episodes' ? 'page' : undefined}
      >{t.navEpisodes}</a
    >
  </nav>
  <div class="header-end">
    <p class="lang" aria-label={t.langLabel}>
      {
        /* Ordre fixe : la langue courante est signalée par aria-current, jamais
           en changeant de place, pour que la cible reste au même endroit. */
        locales.map((code, index) => (
          <>
            {index > 0 && <em aria-hidden="true">/</em>}
            <a
              href={pageHref(code)}
              lang={ui[code].htmlLang}
              hreflang={ui[code].htmlLang}
              aria-current={code === lang ? 'true' : undefined}
            >
              {code.toUpperCase()}
            </a>
          </>
        ))
      }
    </p>
  </div>
</header>
