---
import '../styles/global.css';
import { ui, localePath, asset, otherLocale, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const other = otherLocale[lang];
const canonical = new URL(localePath(lang), Astro.site).href;
const otherHref = new URL(localePath(other), Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <meta name="theme-color" content="#151715" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={t.htmlLang} href={canonical} />
    <link rel="alternate" hreflang={ui[other].htmlLang} href={otherHref} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en'), Astro.site).href} />

    <meta property="og:title" content="Agentic Crafters" />
    <meta property="og:description" content={t.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
